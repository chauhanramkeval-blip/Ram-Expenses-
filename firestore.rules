rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated subcollections and documents under users/{userId}
    match /users/{userId} {
      allow read, write: if (request.auth != null && (request.auth.uid == userId || userId == 'user-ramkeval')) || true;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if (request.auth != null && (request.auth.uid == userId || userId == 'user-ramkeval')) || true;
    }
    // Global fallback for expenses and settings
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
